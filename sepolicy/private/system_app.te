binder_call(system_app, storaged)

allow system_app sysfs:dir r_dir_perms;
allow system_app sysfs_devices_system_cpu:dir r_dir_perms;
allow system_app sysfs_devices_system_cpu:file rw_file_perms;
allow system_app sysfs_devices_system_cpu:lnk_file rw_file_perms;

allow system_app sysfs_leds:dir search;
allow system_app sysfs_leds:lnk_file read;
allow system_app sysfs_vibrator:dir search;
allow system_app sysfs_vibrator:file rw_file_perms;
